DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_AUTH_BASE_URL=https://your-project.neonauth.region.aws.neon.tech/dbname/auth
NEON_AUTH_COOKIE_SECRET=your-secret-here
INGEST_API_KEY=replace-with-long-random-secret
# Optional multi-key config (preferred for scoped keys / rotation):
# INGEST_API_KEYS_JSON=[{"id":"local-dev","key":"replace-with-long-random-secret","scopes":["ingest:write","ingest:dryrun"]}]
INGEST_CLEANUP_INTERVAL_MS=60000
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=60
INGEST_IDEMPOTENCY_TTL_MS=3600000
APP_URL=http://localhost:3001
PORT=3001
