{
  "name": "tennis-zero-six-alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "test:ingest-api": "tsx scripts/test-ingest-api.ts",
    "test:ingest-api:db": "tsx scripts/test-ingest-api-db.ts",
    "test:ingest-api:scopes": "tsx scripts/test-ingest-api-scopes.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
