# Append this file into your .env for Journal LLM testing
# Example: cat .env-llm >> .env

JOURNAL_LLM_ENABLED=true
JOURNAL_LLM_PROVIDER=openai-compatible
JOURNAL_LLM_BASE_URL=http://192.168.86.28:1234/v1
JOURNAL_LLM_BASE_URL_SECONDARY=http://192.168.86.21:1234/v1
JOURNAL_LLM_USE_SECONDARY_BASE_URL=false
JOURNAL_LLM_API_KEY=lmstudio

# Primary model
JOURNAL_LLM_MODEL=openai/gpt-oss-20b

# Secondary model
JOURNAL_LLM_SECONDARY_MODEL=liquid/lfm2.5-1.2b

# Tertiary model
JOURNAL_LLM_TERTIARY_MODEL=gemma-3-1b-it-qat

# Optional no-auth test endpoint key for /api/journal/preview-test
JOURNAL_LLM_TEST_PREVIEW_KEY=local-journal-test-key

# Optional feature flag: 2-pass extraction (recall pass + schema pass)
JOURNAL_LLM_TWO_PASS=false

JOURNAL_LLM_TIMEOUT_MS=60000
JOURNAL_LLM_MAX_INPUT_CHARS=12000
