      "versionNonce": 1129,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1710000000019,
      "link": null,
      "locked": false,
      "text": "Rule cards (explainable):\n- High-intensity + struggle appears 3x this week.\n- Coach-tag days correlate with positive mood (4/5).\n- Recovery tags absent for 5 days in a row.\n\nKeep rule-based wording: \"appears with\" / \"co-occurs\", not causal claims.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rule cards (explainable):\n- High-intensity + struggle appears 3x this week.\n- Coach-tag days correlate with positive mood (4/5).\n- Recovery tags absent for 5 days in a row.\n\nKeep rule-based wording: \"appears with\" / \"co-occurs\", not causal claims.",
      "lineHeight": 1.25,
      "baseline": 18
    },
